# Base URL for a real backend. Only the routes listed in REAL_API_ROUTES
# (src/lib/http.ts, currently POST /auth/login) are sent here; every other
# request stays relative and is served by the in-browser MSW mock layer.
# Leave empty to run the whole app against the mock API.
VITE_API_BASE_URL=

# Set to "false" to disable the MSW mock layer entirely and send every request
# to VITE_API_BASE_URL. Defaults to enabled so demo data keeps working while
# endpoints are migrated one by one.
VITE_ENABLE_MOCK_API=true

# Sentry DSN for client-side error reporting. When set, the app lazily
# initializes @sentry/browser and reports exceptions/events. Leave empty
# to keep monitoring inert (it falls back to console logging).
VITE_SENTRY_DSN=

# Environment label attached to Sentry events (e.g. "production", "staging").
# Defaults to the Vite mode when unset.
VITE_APP_ENV=
