# Base URL for the NestJS backend. All BarberShop API requests are routed here;
# leave it empty only when deliberately running the standalone MSW mock mode.
VITE_API_BASE_URL=

# Set to "false" for the normal local integration with NestJS. Keep it enabled
# only for tests or the standalone mock mode; real API routes still bypass MSW.
VITE_ENABLE_MOCK_API=true

# Sentry DSN for client-side error reporting. When set, the app lazily
# initializes @sentry/browser and reports exceptions/events. Leave empty
# to keep monitoring inert (it falls back to console logging).
VITE_SENTRY_DSN=

# Environment label attached to Sentry events (e.g. "production", "staging").
# Defaults to the Vite mode when unset.
VITE_APP_ENV=
